{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "declaration": true, "emitDeclarationOnly": true, "outDir": "dist", "rootDir": "src",
    "skipLibCheck": true, "verbatimModuleSyntax": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "types": ["vite/client", "@cloudflare/workers-types"]
  },
  "include": ["src"]
}
